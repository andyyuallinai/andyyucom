{
  "name": "andyyuuk.com-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name andyyuuk-personal",
    "cf:db:create": "wrangler d1 create andyyuuk-personal-db",
    "cf:db:migrate:local": "wrangler d1 migrations apply andyyuuk-personal-db --local",
    "cf:db:migrate:remote": "wrangler d1 migrations apply andyyuuk-personal-db --remote",
    "cf:secret:set": "wrangler secret put GEMINI_API_KEY"
  },
  "dependencies": {
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.72.0"
  }
}
